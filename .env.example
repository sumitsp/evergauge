# Copy to .env and fill in values before `docker compose up`

# App
PORT=3001
APP_PORT=3001
NODE_ENV=production

# MySQL — remote host, or `mysql` when using: docker compose --profile local-db up
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=evergauge
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=quality_tracking

# Optional local MySQL (profile: local-db)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PUBLISH_PORT=3306

# Anthropic (Claude) + OpenAI — both score, then we average
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REQUIRE_ANTHROPIC=false

# Auth
DEFAULT_USER_PASSWORD=EverGauge2026!

# Google Sign-In — add your Docker host origin in Google Cloud Console
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_AUTO_ROLE=admin
