{
  "name": "quality-assessment-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node server/free-ports.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run server:dev\" \"vite\"",
    "server": "node server/index.js",
    "server:dev": "nodemon --watch server --ext js,json --delay 500ms server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "nodemon": "^3.1.14",
    "vite": "^7.0.0"
  }
}
